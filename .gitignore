# Local state and secrets
.env
.env.*
!.env.example
*.secret
*.pem
*.key
backups/
.local/

# Runtime output: schemas/examples are versioned, machine runs are not.
telemetry/runs/*.jsonl
telemetry/errors/*.jsonl
telemetry/escalations/*.jsonl
telemetry/spans/*.jsonl
telemetry/opencode/*.jsonl
benchmarks/results/*.json
benchmarks/results/*.jsonl
evals/results/*.jsonl
datasets/accepted/*.jsonl
datasets/rejected/*.jsonl
datasets/candidates/*.jsonl
!telemetry/runs/.gitkeep
!telemetry/errors/.gitkeep
!telemetry/escalations/.gitkeep
!telemetry/spans/.gitkeep
!telemetry/opencode/.gitkeep
!benchmarks/results/.gitkeep
!evals/results/.gitkeep
!datasets/accepted/.gitkeep
!datasets/rejected/.gitkeep
!datasets/candidates/.gitkeep

# Tooling artifacts
__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
*.log
