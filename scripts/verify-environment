#!/usr/bin/env python3
"""Read-only environment and repository validation."""

from __future__ import annotations

import json
import os
import pathlib
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts/common"))
import infra  # noqa: E402
import authority  # noqa: E402
import telemetry  # noqa: E402

OLLAMA_ENDPOINT = "http://127.0.0.1:11434/api/tags"
NOT_CONFIGURED_BY_MACHINE_POLICY = "NOT_CONFIGURED_BY_MACHINE_POLICY"


def version(command: list[str]) -> str:
    executable = shutil.which(command[0])
    if not executable:
        return "UNAVAILABLE"
    result = subprocess.run(command, capture_output=True, text=True)
    text = (result.stdout or result.stderr).strip().splitlines()
    return text[0] if result.returncode == 0 and text else "UNAVAILABLE"


def machine_policy() -> dict:
    """The ONE canonical machine policy for this checkout (scripts/common/authority.py).

    Reads the committed descriptor directly: a machine-local file may override a
    preference but never a hard prohibition. Machine identity is ``LAI_MACHINE`` when
    set; otherwise the descriptor whose declared ``repo_path`` is this exact
    repository (never guessed, only matched). Never raises: the resolved state is
    reported, and INVALID states are reported as INVALID rather than as permitted.
    """
    return authority.machine_policy(dict(os.environ))


def machine_local_inference_policy() -> str | None:
    """Canonical local-inference state, or None when the machine does not prohibit it.

    ``None`` means "not prohibited" only. An INVALID policy also reports ``None`` here,
    so callers that must not confuse the two read :func:`machine_policy` and its
    ``state`` (main() does).
    """
    return machine_policy().get("local_inference")


def main() -> int:
    failures = []
    for path in sorted(infra.PROFILE_DIR.glob("*.yaml")):
        try:
            infra.load_profile(path.stem)
            print(f"PASS profile {path.stem}")
        except infra.InfraError as exc:
            failures.append(str(exc))
    for relative in ("models/registry.yaml", "models/roles.yaml", "hardware/current-machine.yaml",
                     "telemetry/schemas/ai-run.schema.json", "telemetry/schemas/error-event.schema.json",
                     "telemetry/schemas/escalation-run.schema.json", "telemetry/schemas/span-event.schema.json",
                     "telemetry/schemas/opencode-stats.schema.json", "telemetry/schemas/task-outcome.schema.json",
                     "telemetry/taxonomy/failure-categories.yaml", "config/limits.yaml", "config/pricing.yaml",
                     "datasets/schemas/accepted-task.schema.json", "datasets/schemas/learning-candidate.schema.json"):
        try:
            infra.load_json(ROOT / relative)
            print(f"PASS syntax {relative}")
        except infra.InfraError as exc:
            failures.append(str(exc))
    try:
        telemetry.load_limits()
        print("PASS limits config/limits.yaml")
    except infra.InfraError as exc:
        failures.append(str(exc))
    policy = machine_policy()
    state = policy["state"]
    invalid = state in authority.INVALID_POLICY_STATES
    prohibited = state in authority.INVALID_POLICY_STATES or "ollama" in policy["prohibited"]
    if invalid:
        # An unresolvable authority is not a permission: never probe, never ready.
        failures.append(f"MACHINE_POLICY_INVALID ({state}): {policy['error']}")
    tools = {
        "python": ["python3", "--version"],
        "qwen": ["qwen", "--version"], "node": ["node", "--version"], "npm": ["npm", "--version"],
        "dotnet": ["dotnet", "--version"],
    }
    if not prohibited:
        tools["ollama"] = ["ollama", "--version"]
    for name, command in tools.items():
        print(f"{name}: {version(command)}")
    if invalid:
        print(f"MACHINE POLICY: {state}")
        print("Ollama health: SKIPPED_INVALID_MACHINE_POLICY")
    elif "ollama" in policy["prohibited"]:
        print(f"Ollama: {policy['prohibited']['ollama']}")
        print("Ollama health: SKIPPED_BY_POLICY")
    else:
        if state == authority.GENUINELY_UNREGISTERED_MACHINE:
            print(f"Ollama policy: {authority.NO_MACHINE_POLICY} "
                  "(no registered machine declares this checkout)")
        try:
            with urllib.request.urlopen(OLLAMA_ENDPOINT, timeout=3) as response:
                print(f"Ollama health: HTTP {response.status}")
        except (urllib.error.URLError, TimeoutError) as exc:
            failures.append(f"Ollama health unavailable: {exc}")
    if failures:
        for failure in failures:
            print(f"FAIL {failure}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
