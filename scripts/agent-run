#!/usr/bin/env python3
"""Run a task, a single tool, or a health check through the Agent Runtime.

A health check is read-only and never downloads a model. Execution requires
``--confirm-run`` and never pulls a model either. Prompts are sent to the
provider but never stored; the runtime records only sanitized spans. Tool
execution is confined to the ``--workspace`` root.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
import uuid

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "common"))
import escalation  # noqa: E402
import infra  # noqa: E402
import providers  # noqa: E402
import runtime  # noqa: E402
import telemetry  # noqa: E402
import tool_runtime  # noqa: E402


def _uuid(value: str) -> str:
    try:
        uuid.UUID(value)
    except ValueError:
        raise argparse.ArgumentTypeError("not a UUID: %s" % value)
    return value


def _record_task_outcome(args, agent, result, outcome, fallback, started_at) -> None:
    """Append one compact outcome for the completed task; never affects exit status."""
    path = args.outcome_output or (infra.ROOT / "telemetry/outcomes/runs.jsonl")
    try:
        record = telemetry.build_task_outcome(
            result,
            escalation=outcome,
            task_type=args.task_type,
            started_at=started_at,
            initial_variant=getattr(agent.provider, "reasoning_profile", None),
            final_variant=getattr(fallback, "reasoning_profile", None) if fallback is not None else None,
            pricing_config=agent.pricing,
        )
        infra.append_jsonl(path, record)
    except (infra.InfraError, OSError):
        return


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--health", action="store_true", help="Report provider readiness and exit")
    parser.add_argument("--prompt", help="Task prompt; never stored in telemetry")
    parser.add_argument("--prompt-file", type=pathlib.Path, help="Read the prompt from a file")
    parser.add_argument("--provider", help="Provider name from config/runtime.yaml")
    parser.add_argument("--model", help="Override the configured model")
    parser.add_argument("--role", default="student", choices=("student", "teacher-cheap", "teacher-premium"))
    parser.add_argument("--task-type", help="Optional task type recorded on the task outcome")
    parser.add_argument("--trace-id", type=_uuid, help="Reuse an existing trace for continuity")
    parser.add_argument("--timeout-seconds", type=float, help="Per-attempt timeout override")
    parser.add_argument("--max-attempts", type=int, help="Bounded attempts for retryable failures")
    parser.add_argument("--config", type=pathlib.Path, help="Runtime config path")
    parser.add_argument("--span-output", type=pathlib.Path, help="Span JSONL destination")
    parser.add_argument("--workspace", type=pathlib.Path, help="Workspace root; enables tool execution")
    parser.add_argument("--tool", help="Run one tool instead of inference (requires --workspace)")
    parser.add_argument("--params", help="JSON object of tool parameters")
    parser.add_argument("--escalate", action="store_true", help="Enable escalation for this run")
    parser.add_argument("--escalation-mode", choices=("manual", "automatic"), help="Override escalation mode")
    parser.add_argument("--hosted", action="store_true", help="Allow hosted execution; may incur provider cost")
    parser.add_argument("--task-class", default="general", help="Escalation telemetry task class")
    parser.add_argument("--escalation-output", type=pathlib.Path, help="Escalation JSONL destination")
    parser.add_argument("--outcome-output", type=pathlib.Path, help="Task outcome JSONL destination")
    parser.add_argument("--confirm-run", action="store_true", help="Required for execution, not for health")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    args = parser.parse_args()

    config = providers.load_runtime_config(args.config) if args.config else providers.load_runtime_config()
    tool_engine = None
    if args.workspace is not None:
        tool_engine = tool_runtime.ToolRuntime(
            args.workspace, span_output=args.span_output, role=args.role
        )
    agent = runtime.AgentRuntime.from_config(
        config, args.provider, span_output=args.span_output, role=args.role, tools=tool_engine
    )

    if args.health:
        health = agent.health_check()
        print(json.dumps(health, indent=2) if args.json else "provider=%s status=%s model=%s detail=%s" % (
            health["provider"], health["status"], health["model"], health["detail"]))
        return 0 if health["status"] == "healthy" else 1

    if not args.confirm_run:
        parser.error("--confirm-run is required for execution; models are never downloaded or run implicitly")

    if args.tool:
        if tool_engine is None:
            parser.error("--tool requires --workspace")
        if args.escalate:
            parser.error("--escalate applies to inference runs, not --tool")
        try:
            params = json.loads(args.params) if args.params else {}
        except json.JSONDecodeError as exc:
            parser.error("--params must be a JSON object: %s" % exc)
        if not isinstance(params, dict):
            parser.error("--params must be a JSON object")
        session = agent.open_session(runtime.AgentTask(prompt=args.tool, trace_id=args.trace_id, role=args.role))
        result = agent.call_tool(session, args.tool, params, timeout_seconds=args.timeout_seconds)
        if args.json:
            print(json.dumps(result.as_dict(), indent=2))
        else:
            print("tool=%s success=%s duration_ms=%s trace_id=%s" % (
                result.tool_name, result.success, result.duration_ms, result.trace_id))
            if result.error_category:
                print("error=%s:%s" % (result.error_category, result.error_code))
            if result.output is not None:
                print(result.output)
        return 0 if result.success else 1

    if args.prompt_file is not None:
        prompt = args.prompt_file.read_text(encoding="utf-8")
    elif args.prompt is not None:
        prompt = args.prompt
    else:
        parser.error("provide --prompt, --prompt-file, or --tool")

    task = runtime.AgentTask(
        prompt=prompt,
        trace_id=args.trace_id,
        model=args.model,
        role=args.role,
        task_type=args.task_type,
        timeout_seconds=args.timeout_seconds,
        max_attempts=args.max_attempts,
    )
    started_at = infra.utc_now()
    session = agent.open_session(task)
    result = agent.run(task, session=session)
    outcome = None
    fallback = None
    if args.escalate:
        policy = escalation.EscalationPolicy.from_config(config)
        policy.enabled = True
        if args.escalation_mode:
            policy.mode = args.escalation_mode
        if args.hosted:
            policy.hosted_allowed = True
        fallback = providers.build_provider(config, policy.fallback_provider)
        controller = escalation.EscalationController(
            policy, fallback, limits=agent.limits, span_output=args.span_output,
            escalation_output=args.escalation_output, role="teacher-cheap",
        )
        outcome = controller.maybe_escalate(session, task, result, task_class=args.task_class)

    _record_task_outcome(args, agent, result, outcome, fallback, started_at)

    if args.json:
        payload = result.as_dict()
        if outcome is not None:
            payload = {"result": payload, "escalation": outcome.as_dict()}
        print(json.dumps(payload, indent=2))
    else:
        print("status=%s provider=%s model=%s attempts=%s duration_ms=%s trace_id=%s" % (
            result.status, result.provider, result.model, result.attempts, result.duration_ms, result.trace_id))
        if result.error_category:
            print("error=%s:%s retryable=%s" % (result.error_category, result.error_code, result.retryable))
        if result.content is not None:
            print(result.content)
        if outcome is not None:
            print("escalation: action=%s reason=%s eligible=%s escalated=%s provider=%s teacher_run_id=%s" % (
                outcome.action, outcome.reason, outcome.eligible, outcome.escalated,
                outcome.fallback_provider, outcome.teacher_run_id))
            if outcome.teacher_result is not None and outcome.teacher_result.content is not None:
                print(outcome.teacher_result.content)
    if result.status == "succeeded":
        return 0
    if outcome is not None and outcome.escalated and outcome.teacher_result is not None \
            and outcome.teacher_result.status == "succeeded":
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
