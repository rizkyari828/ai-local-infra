#!/usr/bin/env python3
"""Run one explicit Ollama benchmark and append a sanitized summary."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "common"))
import infra  # noqa: E402
import telemetry  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--model", required=True)
    parser.add_argument("--profile", required=True)
    parser.add_argument("--prompt-file", type=pathlib.Path, help="Prompt is sent but never stored in telemetry")
    parser.add_argument("--project", help="Optional non-sensitive project identifier")
    parser.add_argument("--confirm-run", action="store_true", help="Required: inference may be expensive")
    args = parser.parse_args()
    if not args.confirm_run:
        parser.error("--confirm-run is required; benchmarks never run implicitly")
    profile = infra.load_profile(args.profile)
    if args.model != profile["model"]["id"]:
        parser.error("model must match the selected profile")
    conflicts = infra.resource_conflicts(profile)
    if conflicts:
        parser.error("resource guard found another loaded model: " + ", ".join(conflicts))
    timeout_seconds = telemetry.load_limits()["timeouts"]["model_timeout_seconds"]
    prompt = args.prompt_file.read_text(encoding="utf-8") if args.prompt_file else "Return exactly the word READY."
    payload = {
        "model": args.model,
        "prompt": prompt,
        "stream": False,
        "options": {"num_ctx": int(profile["ollama"]["environment"]["OLLAMA_CONTEXT_LENGTH"])},
    }
    started = time.perf_counter()
    status, response, error_category, error_code = "failed", {}, None, None
    try:
        request = urllib.request.Request(
            profile["ollama"]["endpoint"].rstrip("/") + "/api/generate",
            data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"}, method="POST",
        )
        with urllib.request.urlopen(request, timeout=timeout_seconds) as raw:
            response = json.load(raw)
        status = "succeeded"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        error_category, error_code = "runtime", type(exc).__name__
    duration_ms = round((time.perf_counter() - started) * 1000, 3)
    prompt_count = response.get("prompt_eval_count")
    output_count = response.get("eval_count")
    prompt_duration = response.get("prompt_eval_duration")
    generation_duration = response.get("eval_duration")
    event = infra.base_event(
        project=args.project, agent_client="benchmark-model", model=args.model, profile=args.profile,
        operation_tool="ollama.generate", task_type="direct-benchmark", duration_ms=duration_ms,
        input_tokens=prompt_count, output_tokens=output_count,
        context_configured=int(profile["ollama"]["environment"]["OLLAMA_CONTEXT_LENGTH"]),
        prompt_tokens_per_second=(prompt_count / (prompt_duration / 1e9) if prompt_count and prompt_duration else None),
        generation_tokens_per_second=(output_count / (generation_duration / 1e9) if output_count and generation_duration else None),
        status=status, error_category=error_category, error_code=error_code,
        error_fingerprint=(infra.error_fingerprint("benchmark-model", args.model, "ollama.generate", error_category, error_code)
                           if error_code else None),
        profile_version=profile["version"], hardware_profile=profile["hardware_profile"], config_version="v0.1",
    )
    try:
        telemetry.validate_ai_run_event(event)
    except infra.InfraError as exc:
        print(f"error: refusing to persist malformed telemetry: {exc}", file=sys.stderr)
        return 1
    destination = infra.ROOT / "benchmarks/results/runs.jsonl"
    infra.append_jsonl(destination, event)
    print(json.dumps(event, indent=2))
    print(f"Sanitized result appended to {destination}; prompt and response text were not stored")
    return 0 if status == "succeeded" else 1


if __name__ == "__main__":
    raise SystemExit(main())
