#!/usr/bin/env python3
"""Local evidence ledger + shared derived knowledge CLI (read-only unless you record/promote).

    ./scripts/learn status
    ./scripts/learn seed                     # idempotent import of shared historical seed
    ./scripts/learn record --task-family F --class NORMAL --tier BALANCED --effort MEDIUM \
                           --outcome SUCCESS --surface opencode
    ./scripts/learn query --task-family configuration_resolution
    ./scripts/learn candidates
    ./scripts/learn promote --destination learned-default --family F --tier FAST --effort LOW \
                            --samples 5 --success-ratio 0.9 --reviewer me --human-accepted
    ./scripts/learn reset --confirm          # local DB only; shared knowledge untouched

Deterministic and local: no LLM/provider call, no inference, no downloads. Raw
prompts/responses/sessions are never accepted. Shared knowledge is Git-portable;
the SQLite DB is machine-local and never committed.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "common"))
import evidence  # noqa: E402
import derived_knowledge  # noqa: E402
import outcomes  # noqa: E402


def _emit(payload: dict, as_json: bool) -> int:
    if as_json:
        print(json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True))
    else:
        for key, value in payload.items():
            print(f"{key}: {value}")
    return 0


def cmd_status(args) -> int:
    result = evidence.status(state_dir=args.state_dir)
    cand = outcomes.candidates(state_dir=args.state_dir)
    result["promotion_candidates"] = cand["count"]
    result["prunable_estimate"] = outcomes.prune_dry_run(state_dir=args.state_dir)["eligible_rows"]
    return _emit(result, args.json)


def cmd_seed(args) -> int:
    result = evidence.import_seed(derived_knowledge.load_historical_seed(), state_dir=args.state_dir)
    return _emit(result, args.json)


def cmd_record(args) -> int:
    observation = {
        "task_family": args.task_family, "task_class": args.task_class, "surface": args.surface,
        "provider": args.provider, "model": args.model, "native_variant": args.variant,
        "normalized_effort": args.effort, "outcome": args.outcome,
        "failure_category": args.failure_category, "source": args.source,
        "confidence": args.confidence, "escalated": args.escalated,
        "initial_tier": args.initial_tier or args.tier, "initial_effort": args.initial_effort or args.effort,
        "final_tier": args.final_tier or args.tier, "final_effort": args.final_effort or args.effort,
    }
    observation = {key: value for key, value in observation.items() if value is not None}
    observation_id = evidence.record(observation, state_dir=args.state_dir)
    return _emit({"recorded": observation_id}, args.json)


def cmd_query(args) -> int:
    result = evidence.query(task_family=args.task_family, failure_category=args.failure_category,
                            state_dir=args.state_dir)
    if args.failure_category:
        result["failure_lessons"] = derived_knowledge.failure_lessons(args.failure_category)
    if args.task_family:
        lessons = derived_knowledge.relevant_lessons(args.task_family)
        if lessons:
            result["relevant_lessons"] = [lesson["lesson_id"] for lesson in lessons]
    return _emit(result, args.json)


def cmd_candidates(args) -> int:
    return _emit(outcomes.candidates(state_dir=args.state_dir), args.json)


def cmd_models(args) -> int:
    rows = outcomes.model_performance(task_family=args.task_family, surface=args.surface,
                                      state_dir=args.state_dir)
    return _emit({"models": rows, "count": len(rows)}, args.json)


def cmd_start(args) -> int:
    decision_id = evidence.start(
        decision_id=args.decision_id, task_family=args.task_family, task_class=args.task_class,
        surface=args.surface, provider=args.provider, model=args.model, native_variant=args.variant,
        initial_tier=args.tier, initial_effort=args.effort, user_override_tier=args.override_tier,
        user_override_effort=args.override_effort, user_override_model=args.override_model,
        state_dir=args.state_dir)
    return _emit({"decision_id": decision_id}, args.json)


def _final_fields(args) -> dict:
    return {"task_family": args.task_family, "task_class": args.task_class, "surface": args.surface,
            "provider": args.provider, "model": args.model, "native_variant": args.variant,
            "normalized_effort": args.effort or args.final_effort,
            "final_tier": args.final_tier or args.tier, "final_effort": args.final_effort or args.effort,
            "failure_category": args.failure_category, "completion_signal": args.completion_signal,
            "attempt_count": args.attempts, "confidence": args.confidence, "source": args.source,
            "user_override_tier": args.override_tier, "user_override_effort": args.override_effort,
            "user_override_model": args.override_model}


def cmd_finish(args) -> int:
    decision_id = evidence.finish(args.decision_id, outcome=args.outcome, state_dir=args.state_dir,
                                  **_final_fields(args))
    return _emit({"finalized": decision_id}, args.json)


def cmd_outcome(args) -> int:
    decision_id = evidence.outcome(decision_id=args.decision_id, outcome=args.outcome,
                                   state_dir=args.state_dir, replace=args.replace, **_final_fields(args))
    return _emit({"recorded": decision_id}, args.json)


def cmd_prune(args) -> int:
    if args.apply:
        raise derived_knowledge.KnowledgeError(
            "prune --apply is deferred in V0.2; only --dry-run is supported")
    return _emit(outcomes.prune_dry_run(state_dir=args.state_dir), args.json)


def cmd_promote(args) -> int:
    candidate = {"destination": args.destination, "task_family": args.family, "tier": args.tier,
                 "effort": args.effort, "samples": args.samples, "success_ratio": args.success_ratio,
                 "reviewer": args.reviewer, "human_accepted": args.human_accepted, "lesson": args.lesson}
    result = derived_knowledge.promote(candidate, apply=args.apply)
    return _emit(result, args.json)


def cmd_reset(args) -> int:
    return _emit(evidence.reset_local(state_dir=args.state_dir, confirm=args.confirm), args.json)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--state-dir", type=pathlib.Path, default=None, help="override local state root")
    common.add_argument("--json", action="store_true")
    sub = result.add_subparsers(dest="command", required=True)

    sub.add_parser("status", parents=[common]).set_defaults(func=cmd_status)
    sub.add_parser("seed", parents=[common]).set_defaults(func=cmd_seed)

    record = sub.add_parser("record", parents=[common])
    record.add_argument("--task-family", required=True)
    record.add_argument("--class", dest="task_class")
    record.add_argument("--surface")
    record.add_argument("--tier")
    record.add_argument("--effort")
    record.add_argument("--initial-tier")
    record.add_argument("--initial-effort")
    record.add_argument("--final-tier")
    record.add_argument("--final-effort")
    record.add_argument("--outcome", required=True, choices=list(derived_knowledge.EVIDENCE_OUTCOMES))
    record.add_argument("--failure-category", choices=list(derived_knowledge.FAILURE_CATEGORIES))
    record.add_argument("--provider")
    record.add_argument("--model")
    record.add_argument("--variant")
    record.add_argument("--source", default="observed_runtime", choices=list(derived_knowledge.SOURCE_TYPES))
    record.add_argument("--confidence")
    record.add_argument("--escalated", action="store_true")
    record.set_defaults(func=cmd_record)

    query = sub.add_parser("query", parents=[common])
    query.add_argument("--task-family")
    query.add_argument("--failure-category", choices=list(derived_knowledge.FAILURE_CATEGORIES))
    query.add_argument("--detail", action="store_true")
    query.set_defaults(func=cmd_query)

    sub.add_parser("candidates", parents=[common]).set_defaults(func=cmd_candidates)

    models = sub.add_parser("models", parents=[common])
    models.add_argument("--task-family")
    models.add_argument("--surface")
    models.set_defaults(func=cmd_models)

    start = sub.add_parser("start", parents=[common])
    start.add_argument("--decision-id")
    start.add_argument("--task-family", required=True)
    start.add_argument("--class", dest="task_class")
    start.add_argument("--surface")
    start.add_argument("--provider")
    start.add_argument("--model")
    start.add_argument("--variant")
    start.add_argument("--tier")
    start.add_argument("--effort")
    start.add_argument("--override-tier")
    start.add_argument("--override-effort")
    start.add_argument("--override-model")
    start.set_defaults(func=cmd_start)

    def add_final_args(parser):
        parser.add_argument("--outcome", required=True, choices=list(derived_knowledge.EVIDENCE_OUTCOMES))
        parser.add_argument("--task-family")
        parser.add_argument("--class", dest="task_class")
        parser.add_argument("--surface")
        parser.add_argument("--provider")
        parser.add_argument("--model")
        parser.add_argument("--variant")
        parser.add_argument("--tier")
        parser.add_argument("--effort")
        parser.add_argument("--final-tier")
        parser.add_argument("--final-effort")
        parser.add_argument("--failure-category", choices=list(derived_knowledge.FAILURE_CATEGORIES))
        parser.add_argument("--completion-signal", choices=list(evidence.COMPLETION_SIGNALS))
        parser.add_argument("--attempts", type=int)
        parser.add_argument("--confidence")
        parser.add_argument("--source", default="observed_runtime", choices=list(derived_knowledge.SOURCE_TYPES))
        parser.add_argument("--override-tier")
        parser.add_argument("--override-effort")
        parser.add_argument("--override-model")

    finish = sub.add_parser("finish", parents=[common])
    finish.add_argument("--decision-id", required=True)
    add_final_args(finish)
    finish.set_defaults(func=cmd_finish)

    outcome = sub.add_parser("outcome", parents=[common])
    outcome.add_argument("--decision-id")
    outcome.add_argument("--replace", action="store_true")
    add_final_args(outcome)
    outcome.set_defaults(func=cmd_outcome)

    prune = sub.add_parser("prune", parents=[common])
    prune.add_argument("--dry-run", action="store_true", default=True)
    prune.add_argument("--apply", action="store_true")
    prune.set_defaults(func=cmd_prune)

    promote = sub.add_parser("promote", parents=[common])
    promote.add_argument("--destination", default="learned-default")
    promote.add_argument("--family", required=True)
    promote.add_argument("--tier", required=True)
    promote.add_argument("--effort", required=True)
    promote.add_argument("--samples", type=int, default=0)
    promote.add_argument("--success-ratio", type=float, default=0.0)
    promote.add_argument("--reviewer", required=True)
    promote.add_argument("--human-accepted", action="store_true")
    promote.add_argument("--lesson", default="")
    promote.add_argument("--apply", action="store_true", help="mutate shared knowledge (default is dry-run)")
    promote.set_defaults(func=cmd_promote)

    reset = sub.add_parser("reset", parents=[common])
    reset.add_argument("--confirm", action="store_true")
    reset.set_defaults(func=cmd_reset)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except (evidence.EvidenceError, derived_knowledge.KnowledgeError, OSError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
