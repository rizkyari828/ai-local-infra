#!/bin/sh
# Portable bootstrap launcher (multi-machine sync).
#
# Thin wrapper over the shared supported-Python launcher (scripts/common/launch):
# selects an already-installed CPython >= 3.11 and runs
# scripts/common/bootstrap_cli.py with the original arguments and exit code.
# bootstrap.py uses stdlib ``tomllib``, which only exists from Python 3.11;
# Python 3.9/3.10 are rejected up front instead of failing with an obscure
# ``ModuleNotFoundError: tomllib``.
#
# It never mutates PATH, never installs anything, and never lets uv (or anything
# else) download a Python. Set LAI_PYTHON to force an explicit interpreter.
set -u

# Resolve this script's directory without relying on external tools.
self=$0
case $self in
    */*) ;;
    *) self=$(command -v "$self" 2>/dev/null) || self=$0 ;;
esac
here=${self%/*}
[ "$here" = "$self" ] && here=.

exec "$here/common/launch" "$here/common/bootstrap_cli.py" "$@"
