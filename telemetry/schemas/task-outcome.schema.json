{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-infra/telemetry/task-outcome/1.0.0",
  "title": "Completed task outcome",
  "description": "One compact outcome row per completed task. Aggregates the existing runtime result and, when present, the escalation outcome for a trace_id: success/status from runtime signals, initial/final provider/model/variant, escalation count, attempts, end-to-end latency, and cost. Metadata only: never stores prompts, responses, source, chain-of-thought, credentials, or auth headers. Files are append-only; duplicate task_id rows are collapsed to the latest at read time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "event_id", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "format": "uuid", "description": "Trace/task correlation id; the dedupe key."},
    "event_id": {"type": "string", "format": "uuid"},
    "completed_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "run_id": {"type": ["string", "null"], "format": "uuid", "description": "Final run that completed the task."},
    "task_type": {"type": ["string", "null"]},
    "status": {"enum": ["succeeded", "failed", "cancelled", "unknown", null]},
    "success": {"type": ["boolean", "null"]},
    "tests_passed": {"type": ["boolean", "null"]},
    "escalated": {"type": ["boolean", "null"]},
    "escalation_count": {"type": ["integer", "null"], "minimum": 0},
    "attempt_count": {"type": ["integer", "null"], "minimum": 0},
    "initial_provider": {"type": ["string", "null"]},
    "initial_model": {"type": ["string", "null"]},
    "initial_variant": {"type": ["string", "null"]},
    "final_provider": {"type": ["string", "null"]},
    "final_model": {"type": ["string", "null"]},
    "final_variant": {"type": ["string", "null"]},
    "total_latency_ms": {"type": ["number", "null"], "minimum": 0},
    "provider_reported_cost": {"type": ["number", "null"], "minimum": 0},
    "estimated_total_cost": {"type": ["number", "null"], "minimum": 0},
    "pricing_currency": {"type": ["string", "null"]},
    "error_category": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]}
  }
}
