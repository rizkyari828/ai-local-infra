{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-infra/telemetry/opencode-stats/1.0.0",
  "title": "OpenCode stats snapshot row",
  "description": "One normalized model row imported from `opencode stats --json`. Snapshot-based: all rows from one import share a content-derived snapshot_id, and an identical snapshot is not appended twice. Uses the same usage vocabulary as runtime spans. OpenCode's tokens.input is the uncached portion and maps to cache_miss_tokens; input_tokens is the uncached + cache.read total. provider_reported_cost keeps OpenCode's own cost separate from any locally estimated cost. Aggregates only: never stores prompts, messages, source, credentials, or raw stats payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "captured_at", "provider", "model"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "variant": {"type": ["string", "null"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_miss_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_hit_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "provider_reported_cost": {"type": ["number", "null"], "minimum": 0},
    "estimated_total_cost": {"type": ["number", "null"], "minimum": 0},
    "pricing_profile": {"type": ["string", "null"]},
    "pricing_currency": {"type": ["string", "null"]},
    "sessions": {"type": ["integer", "null"], "minimum": 0},
    "subagents": {"type": ["integer", "null"], "minimum": 0},
    "prompts": {"type": ["integer", "null"], "minimum": 0},
    "steps": {"type": ["integer", "null"], "minimum": 0},
    "agent_client": {"type": ["string", "null"]},
    "opencode_version": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]}
  }
}
