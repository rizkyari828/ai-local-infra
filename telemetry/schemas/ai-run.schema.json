{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-infra/telemetry/ai-run/1.0.0",
  "title": "Local AI run or event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "event_id", "timestamp_utc", "event_type", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string"},
    "project": {"type": ["string", "null"]},
    "agent_client": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "model_digest": {"type": ["string", "null"]},
    "profile": {"type": ["string", "null"]},
    "operation_tool": {"type": ["string", "null"]},
    "task_type": {"type": ["string", "null"]},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "context_configured": {"type": ["integer", "null"], "minimum": 0},
    "context_used": {"type": ["integer", "null"], "minimum": 0},
    "prompt_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
    "generation_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
    "tool_call_count": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["started", "succeeded", "failed", "cancelled", "unknown"]},
    "error_category": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]},
    "error_fingerprint": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "eval_suite": {"type": ["string", "null"]},
    "eval_version": {"type": ["string", "null"]},
    "eval_score": {"type": ["number", "null"]},
    "structured_output_compliant": {"type": ["boolean", "null"]},
    "test_status": {"type": ["string", "null"]},
    "review_status": {"enum": ["unreviewed", "accepted", "rejected", "needs-review"]},
    "profile_version": {"type": ["string", "null"]},
    "ollama_version": {"type": ["string", "null"]},
    "client_version": {"type": ["string", "null"]},
    "hardware_profile": {"type": ["string", "null"]},
    "config_version": {"type": ["string", "null"]}
  }
}
