{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-infra/telemetry/escalation-run/1.1.0",
  "title": "Teacher/student escalation run",
  "description": "Flat, privacy-conscious extension of the v0.1 telemetry model for the teacher/student learning loop. Invariant: one row summarizes one coding task, and teacher_* fields describe the final teacher escalation for that task; attempt-level multi-tier rows are deferred. Schema 1.1.0 adds optional trace_id, which links the task summary to runtime spans (telemetry/span-event) and to learning candidates. 1.0.0 rows remain valid. Null-capable columns keep JSONL compatible with future Parquet/DuckDB conversion. Never captures prompts, source, secrets, or credentials; a minimal accidental secret-capture guard rejects obvious credential shapes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "event_id", "timestamp_utc", "task_class", "student_model", "student_outcome"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "run_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "parent_run_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "task_class": {"type": "string"},
    "student_role": {"const": "student"},
    "student_model": {"type": "string"},
    "student_profile": {"type": ["string", "null"]},
    "student_outcome": {"enum": ["succeeded", "failed", "uncertain", "blocked"]},
    "failure_category": {"type": ["string", "null"]},
    "teacher_provider": {"type": ["string", "null"]},
    "teacher_model": {"type": ["string", "null"]},
    "teacher_reason": {"enum": ["failure", "uncertainty", "policy", "timeout", "other", null]},
    "teacher_outcome": {"enum": ["accepted", "rejected", "partial", "unused", "unknown", null]},
    "human_review_outcome": {"enum": ["unreviewed", "accepted", "rejected", "needs-review", null]},
    "correction_required": {"type": ["boolean", "null"]},
    "human_correction_count": {"type": ["integer", "null"], "minimum": 0},
    "tests_passed": {"type": ["boolean", "null"]},
    "lesson_candidate": {"type": "boolean"},
    "eval_candidate": {"type": "boolean"},
    "training_candidate": {"type": "boolean"},
    "duration_ms": {"type": ["number", "null"], "minimum": 0},
    "cost_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_cache_hit_tokens": {"type": ["integer", "null"], "minimum": 0},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "pricing_source": {"type": ["string", "null"]},
    "recorded_by": {"type": ["string", "null"]},
    "sanitized_note": {"type": ["string", "null"]},
    "context_pack": {
      "type": ["object", "null"],
      "description": "Optional provider-neutral shared escalation context pack (schema scripts/common/context_pack.py). Distilled task state only: no prompts, chain-of-thought, source contents, or credentials. Schema 1.2.0 adds this null-capable column; 1.0.0/1.1.0 rows remain valid.",
      "additionalProperties": false,
      "required": ["context_pack_version", "goal"],
      "properties": {
        "context_pack_version": {"const": "1.0.0"},
        "goal": {"type": "string"},
        "task_type": {"type": ["string", "null"]},
        "current_state": {"type": ["string", "null"]},
        "relevant_files": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "changes_attempted": {"type": "array", "items": {"type": "string"}},
        "approaches_tried": {"type": "array", "items": {"type": "string"}},
        "failure_category": {"type": ["string", "null"]},
        "error_summary": {"type": ["string", "null"]},
        "failed_tests": {"type": "array", "items": {"type": "string"}},
        "test_results": {"type": "array", "items": {"type": "string"}},
        "observations": {"type": "array", "items": {"type": "string"}},
        "lessons": {"type": "array", "items": {"type": "string"}},
        "recommended_next_action": {"type": ["string", "null"]},
        "source_provider": {"type": ["string", "null"]},
        "source_model": {"type": ["string", "null"]},
        "source_variant": {"type": ["string", "null"]}
      }
    }
  }
}
