{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-infra/telemetry/span-event/1.0.0",
  "title": "Runtime stage span",
  "description": "One completed runtime span for bottleneck observability. Spans share a trace_id with run and escalation events so a task can be followed end-to-end. Flat, null-capable columns keep JSONL compatible with future Parquet/DuckDB conversion. Never captures prompts, source, secrets, or raw file paths (use target_hash).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "span_id", "timestamp_utc", "stage", "duration_ms"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trace_id": {"type": "string", "format": "uuid"},
    "span_id": {"type": "string", "format": "uuid"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "parent_span_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "stage": {"enum": ["inference", "tool", "validation", "review", "escalation", "retry", "queue", "other"]},
    "duration_ms": {"type": "number", "minimum": 0},
    "model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "role": {"type": ["string", "null"]},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "retry_count": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "context_size": {"type": ["number", "null"], "minimum": 0},
    "context_utilization": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "tool_name": {"type": ["string", "null"]},
    "tool_kind": {"enum": ["read", "write", "search", "shell", "test", "git", "other", null]},
    "tool_outcome": {"enum": ["succeeded", "failed", "timeout", "cancelled", null]},
    "target_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "repeated": {"type": ["boolean", "null"]},
    "error_category": {"enum": ["model_reasoning_failure", "provider_failure", "provider_timeout", "tool_failure", "tool_timeout", "validation_failure", "environment_failure", "configuration_failure", "resource_limit", "context_limit", "user_cancelled", "unknown", null]},
    "error_code": {"type": ["string", "null"]},
    "limits_version": {"type": ["string", "null"]},
    "sanitized_note": {"type": ["string", "null"]}
  }
}
